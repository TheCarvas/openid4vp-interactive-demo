# Environment for the hosted deployment. Set these in hPanel under the Node.js
# app's environment variables, not by committing a .env file.

PORT=3000
PUBLIC_ORIGIN=https://openid4vp.lionwolfstar.tech

# Optional. The interface the server listens on. Defaults to 127.0.0.1, which is
# what you want behind a reverse proxy: the proxy terminates TLS and forwards to
# loopback, and nothing can reach the app on its raw port over plaintext HTTP.
# Set 0.0.0.0 only where direct exposure is intended, such as inside a container
# whose port is not published to the internet.
# BIND_HOST=127.0.0.1

# Keep the datastore outside the deployed application directory so a redeploy
# does not delete registered accounts. Replace uXXXXXXXX with your Hostinger
# account's home directory name.
DATA_DIR=/home/uXXXXXXXX/openid4vp-demo-data

FLOW_TTL_SECONDS=300
SIGNUP_TTL_SECONDS=600

GOOGLE_VC_ISSUER=https://verifiablecredentials-pa.googleapis.com
GOOGLE_VC_JWKS=https://verifiablecredentials-pa.googleapis.com/.well-known/vc-public-jwks

# Both stay off in production. The debug UI exposes verifier internals, and
# artifact capture writes raw presented credentials to disk. See the privacy
# note in DEPLOYMENT.md before turning either on for a public deployment.
DEBUG_UI_ENABLED=false
CAPTURE_CREDENTIAL_ARTIFACTS=false
