PORT=3000
FLOW_TTL_SECONDS=300
SIGNUP_TTL_SECONDS=600
GOOGLE_VC_ISSUER=https://verifiablecredentials-pa.googleapis.com
GOOGLE_VC_JWKS=https://verifiablecredentials-pa.googleapis.com/.well-known/vc-public-jwks
DEBUG_UI_ENABLED=true
CAPTURE_CREDENTIAL_ARTIFACTS=true

# Optional. The interface the server listens on. Defaults to 127.0.0.1. Vite
# proxies /api to loopback, so phone testing over the LAN still works; set
# 0.0.0.0 only if something off-host must reach port 3000 directly.
# BIND_HOST=127.0.0.1

# Optional. Where accounts.json, activity.json, and diagnostic traces are kept.
# Defaults to ./.data. Point this outside the deployment directory on a host
# that replaces the directory on every release.
# DATA_DIR=/home/uXXXXXXXX/openid4vp-demo-data

# Optional. Directory of built client assets. Defaults to ./dist.
# STATIC_DIR=dist

# Optional. The canonical browser origin of the deployment. When set, a flow can
# only be bound to this origin, so forwarded headers cannot move the OpenID4VP
# audience onto another host. Leave unset for tunnel-based local testing, where
# the hostname changes per session.
# PUBLIC_ORIGIN=https://openid4vp.lionwolfstar.tech
